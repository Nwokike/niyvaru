# Copy to .env (gitignored) and fill in. The app refuses to start the agent
# without VITE_GATEWAY_KEY — no secret ever ships in code.

# Kiri Gateway (free inference; the family credential you already use)
VITE_GATEWAY_URL=https://api.kiri.ng
VITE_GATEWAY_KEY=

# Mapillary (free developer token, optional — Panoramax/OpenFreeMap cover the rest)
VITE_MAPILLARY_TOKEN=

# Optional Worker mode (adds MET Norway weather + proxy capability):
# VITE_API_BASE=https://your-worker.workers.dev
