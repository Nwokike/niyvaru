# Local browser settings. Vite inlines VITE_* variables at build time;
# copy this file to .env (gitignored) and restart `npm run dev` after changes.
# Never put a secret here — anything prefixed VITE_ ships in the bundle.

# Kiri Gateway (free inference). src/agent/gateway.ts uses the OpenAI-compatible
# adapter and rewrites POST {base}/chat/completions to POST {base}/chat.
VITE_GATEWAY_URL=https://api.kiri.ng
# The gateway credential is the public family key in src/config/endpoints.ts.
# VITE_GATEWAY_KEY is not read by this client; leave it out of the build.

# Mapillary street imagery — free developer token, optional. Without it the
# walk uses Panoramax frames and degrades to a route flythrough.
VITE_MAPILLARY_TOKEN=

# Optional Worker mode. When set, weather uses the Worker's MET Norway proxy
# and /api is proxied by the dev server (NIYVARU_API_TARGET, default
# http://127.0.0.1:8787). Leave blank for the pure static/browser setup.
VITE_API_BASE=

# Build-time base path, set in the build environment rather than .env:
#   VITE_BASE=/niyvaru/ npm run build   (GitHub Pages project site)
# Vite exposes it as import.meta.env.BASE_URL; all assets use it.
