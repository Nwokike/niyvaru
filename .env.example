# Browser settings. Vite inlines VITE_* values at build time.
# Copy to .env only if you need an override, then restart npm run dev.

# Optional inference endpoint. The public family credential lives in config.
VITE_GATEWAY_URL=https://api.kiri.ng

# Optional Mapillary token for extra street imagery.
VITE_MAPILLARY_TOKEN=

# Optional Worker mode for proxied sources and weather headers.
VITE_API_BASE=
